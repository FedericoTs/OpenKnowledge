# OpenKnowledge configuration. Copy to .env and edit.
# Every setting is optional: with an empty .env you get the private, free
# configuration - local retrieval, no outbound network calls, nothing billed.

# --- storage -----------------------------------------------------------------
OK_DATA_DIR=./data
# Folder of company documents. PDF, Word, Excel, PowerPoint and Markdown are
# read; anything else is reported by `openknowledge index` rather than
# silently skipped.
OK_DOCUMENTS_DIR=./documents
# PDF parser: auto | opendataloader | pdfplumber.
#   auto           - OpenDataLoader when a JVM is present, else pdfplumber
#   opendataloader - reports real structure (heading levels, table cells,
#                    PDF/UA tags); needs Java, which the container has
#   pdfplumber     - pure Python, infers structure from geometry
# The two extract slightly different text, so switching invalidates cached
# answers. Pin this if a deployment moves between machines.
OK_PDF_BACKEND=auto

# --- admin -------------------------------------------------------------------
# The admin API is DISABLED until this is set. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OK_ADMIN_TOKEN=

# --- retrieval and grounding -------------------------------------------------
OK_RETRIEVAL_K=6
# Share of an answer's content words that must appear in the sources it cites.
# Raise it to reject more borderline answers (and escalate more often); lower it
# if well-grounded answers are being rejected for paraphrasing.
OK_MIN_SUPPORT_RATIO=0.45
OK_REQUIRE_CITATIONS=true

# --- knowledge lifecycle -----------------------------------------------------
# Draft FAQ answers when documents are added or change. This is the one-off cost
# that removes the recurring one. Prefers your local model when configured.
OK_DRAFT_ON_INGEST=true
# Serve gate-passed drafts nobody has reviewed yet, marked as such. Set false for
# a posture where nothing machine-written reaches staff before sign-off - the
# cost benefit then waits on your review queue.
OK_SERVE_DRAFTS=true
# Refuse questions where two documents disagree, instead of answering from
# whichever one retrieval preferred.
OK_BLOCK_ON_CONFLICT=true
OK_REVERIFY_ON_CHANGE=true
# Cap per run, so a first import of ten thousand files cannot spend unannounced.
OK_MAX_DOCUMENTS_PER_INGEST=200
# Numeric conflict threshold: raise to flag fewer, lower to flag more.
OK_CONFLICT_MIN_OVERLAP=0.34
# Prose conflict strictness: above 1.0 flags fewer. Measure any change with
# `openknowledge eval-conflicts` rather than guessing.
OK_DEONTIC_STRICTNESS=1.0

# --- local model (tier L3) ---------------------------------------------------
# Any OpenAI-compatible endpoint: Ollama, vLLM, LM Studio, llama.cpp.
# Set these with `openknowledge model use <name> [--context N]` rather than by
# hand - it asks the runtime what it has and what window it will run with,
# instead of taking these three lines on faith.
OK_LOCAL_ENABLED=true
OK_LOCAL_MODEL=qwen3:8b
OK_LOCAL_BASE_URL=http://localhost:11434/v1
OK_LOCAL_API_KEY=
# The window the runtime will actually run with, in tokens. 0 means unknown.
# Worth setting, because a window that is too small does not fail: the runtime
# drops tokens off the front of the prompt - where the grounding rules are - and
# answers from the rest. Known, a prompt that would not fit is refused and the
# question moves up a rung instead.
OK_LOCAL_CONTEXT_TOKENS=0

# --- escalation (tier L4) ----------------------------------------------------
# OFF by default. Nothing leaves your network until you turn this on.
OK_ESCALATION_ENABLED=false
OK_ESCALATION_PROVIDER=anthropic
OK_ESCALATION_MODEL=claude-opus-5
OK_ESCALATION_EFFORT=low
OK_ANTHROPIC_API_KEY=
OK_OPENAI_API_KEY=
OK_ESCALATION_BASE_URL=https://api.openai.com/v1

# -- escalation ladder ------------------------------------------------------
# Rungs between the cheap tier and the frontier, cheapest first, as
# `model_id@base_url`. A grounding failure a mid-size open-weight model can fix
# costs about $0.0009 there against $0.037 at the frontier - and escalation is
# where nearly all of a tuned deployment's remaining spend goes.
#
# OK_LADDER=["gpt-oss-120b@https://api.together.xyz/v1"]
OK_LADDER=[]
OK_LADDER_API_KEY=

# -- budget -----------------------------------------------------------------
# Cap on spending over a rolling 24 hours. The governor turns it into a ceiling
# on what one question may cost - budget remaining, divided by questions still
# expected today - and stops trying rungs above that ceiling.
#
# It limits escalation, never service: the cheapest rung is always tried, a
# question the ceiling blocks is refused with the reason rather than answered
# from a rejected attempt, and such refusals are not cached.
# OK_BUDGET_DAILY_USD=5.00
OK_BUDGET_EXPECTED_QUESTIONS_PER_DAY=2000

# -- reranking --------------------------------------------------------------
# Retrieve this many candidates, then rerank down to OK_RETRIEVAL_K. Free, no
# model: it stops one document taking every slot, drops near-duplicate windows,
# and lets a matching heading count for more than an incidental mention.
# Set to 0 to send BM25's own top-k straight through.
OK_RERANK_CANDIDATES=30
OK_RERANK_MAX_PER_DOCUMENT=2

# --- prompt ------------------------------------------------------------------
# Appended to the built-in system prompt, never replacing it: the grounding rules
# are what keep the cheap tiers honest. Editing this changes the cache key, so
# previously cached answers are regenerated under the new wording.
OK_SYSTEM_PROMPT_SUFFIX=

OK_MAX_ANSWER_TOKENS=1500

# -- website ----------------------------------------------------------------
# Serve the marketing page at /site and accept its contact form at /api/contact.
# Off by default: a running answer engine has no business accepting public
# writes unless somebody asked it to. Submissions land in your own SQLite file
# and are read with `openknowledge contacts`.
OK_WEBSITE_ENABLED=false
OK_CONTACTS_DB=contacts.db
OK_CONTACT_MAX_PER_HOUR=60
